{
  "schemaVersion": 1,
  "id": "solyanka",
  "version": "${version}",
  "name": "solyanka",
  "description": "Client utility mod: settings, command keybinds and shortcuts; remaining ports in progress.",
  "environment": "client",
  "license": "GPL-3.0-only",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.solyanka.client.SolyankaClient"
      }
    ],
    "modmenu": [
      "dev.solyanka.client.ui.SolyankaModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
    "yet_another_config_lib_v3": ">=3.9.7"
  },
  "suggests": {
    "modmenu": ">=20.0.3"
  },
  "mixins": [
    {
      "config": "solyanka.client.mixins.json",
      "environment": "client"
    }
  ]
}
