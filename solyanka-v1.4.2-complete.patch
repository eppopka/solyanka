+/* SPDX-License-Identifier: GPL-3.0-only */
+package dev.solyanka.client.ui
+
+import com.google.gson.Gson
+import com.google.gson.JsonPrimitive
+import dev.solyanka.client.SolyankaClient
+import dev.solyanka.client.ui.nofrills.*
+import dev.solyanka.ui.InstantSettings
+import dev.solyanka.ui.NumberRange
+import dev.solyanka.utility.FeatureCodec
+
+object PerformanceUi {
+    fun open(host:NoFrillsClickGui,model:InstantSettings) {
+        var error:String?=null
+        host.showPanel(SettingsPanel("Performance HUD",{host.closePanel()},{error ?: model.error}) {panel,w->
+            val current=Gson().toJsonTree(model.general.features).asJsonObject.getAsJsonObject("performanceHud")
+            fun change(path:String,value:JsonPrimitive) {
+                try {
+                    val root=Gson().toJsonTree(model.general.features).asJsonObject
+                    val target=root.getAsJsonObject("performanceHud")
+                    if(path.startsWith("hud.")) target.getAsJsonObject("hud").add(path.substringAfter('.'),value)
+                    else target.add(path,value)
+                    val next=FeatureCodec.decode(root)
+                    if(!model.updateGeneral {it.copy(features=next)}) error=model.error ?: "Settings not saved" else error=null
+                } catch(e:Exception) {error=e.message ?: "Invalid settings"}
+                panel.refreshStatus()
+            }
+            val s=model.general.features.performanceHud
+            buildList {
