+/* SPDX-License-Identifier: GPL-3.0-only */
+package dev.solyanka.client.feature
+
+import dev.solyanka.client.SolyankaClient as S
+import dev.solyanka.client.ui.HudEditorScreen
+import dev.solyanka.client.ui.nofrills.NoFrillsClickGui
+import dev.solyanka.utility.PerformanceHudSettings
+import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElement
+import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry
+import net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements
+import net.minecraft.client.Minecraft
+import net.minecraft.client.gui.GuiGraphicsExtractor
+import net.minecraft.network.chat.Component
+import net.minecraft.resources.Identifier
+import kotlin.math.roundToInt
+
+/** Small, client-side performance readout. No network requests are made by this HUD. */
+object PerformanceHud {
+    private data class Metric(val label:String,val value:String,val color:Int)
+    private var lastServerTick=0L
+    @Volatile private var tps=20.0
+
+    /** Called from the vanilla client ping handler, on the client thread. */
+    fun serverTick() {
+        val now=System.nanoTime()
+        if(lastServerTick!=0L) {
+            val elapsed=now-lastServerTick
+            if(elapsed in 25_000_000L..5_000_000_000L) {
+                val sample=(1_000_000_000.0/elapsed).coerceIn(0.0,20.0)
+                tps=tps*.8+sample*.2
+            }
+        }
+        lastServerTick=now
+    }
+
+    fun reset() {lastServerTick=0L;tps=20.0}
+
+    private fun metrics(s:PerformanceHudSettings,sample:Boolean=false):List<Metric> {
+        val c=Minecraft.getInstance()
+        val fps=if(sample) 144 else c.getFps()
+        val ping=if(sample) 42 else {
+            val player=c.player
+            player?.uuid?.let {c.connection?.getPlayerInfo(it)?.latency} ?: 0
+        }
+        return buildList {
+            if(s.tps) add(Metric("TPS","%.1f".format(java.util.Locale.ROOT,tps),s.tpsColor))
+            if(s.ping) add(Metric("PING","${ping.coerceAtLeast(0)}ms",s.pingColor))
+            if(s.fps) add(Metric("FPS",fps.coerceAtLeast(0).toString(),s.fpsColor))
+        }
+    }
+
+    private fun opacity(color:Int,factor:Double):Int {
+        val alpha=((color ushr 24)*factor.coerceIn(0.0,1.0)).roundToInt()
+        return (alpha shl 24) or (color and 0x00ffffff)
+    }
+
+    private fun size(font:net.minecraft.client.gui.Font,s:PerformanceHudSettings,items:List<Metric>):Pair<Int,Int> {
+        if(items.isEmpty()) return (s.padding*2+1) to (s.padding*2+10)
+        val widths=items.map {font.width("${it.label} ${it.value}") + s.padding*2}
+        return if(s.vertical) {
+            (widths.maxOrNull() ?: 1) to (s.padding*2+items.size*10)
+        } else {
+            (widths.sum()+((items.size-1)*8)) to (s.padding*2+10)
+        }
+    }
+
+    private fun text(g:GuiGraphicsExtractor,font:net.minecraft.client.gui.Font,text:String,x:Int,y:Int,color:Int,style:String) {
+        val shadow=style=="shadow" || style=="bold"
+        g.text(font,Component.literal(text),x,y,color,shadow)
+        if(style=="bold") g.text(font,Component.literal(text),x+1,y,color,false)
+    }
+
+    private fun draw(g:GuiGraphicsExtractor,s:PerformanceHudSettings,sample:Boolean=false,atX:Int?=null,atY:Int?=null) {
+        val c=Minecraft.getInstance();val items=metrics(s,sample);val (w,h)=size(c.font,s,items)
+        val scale=s.hud.scale.toFloat()
+        val x=atX ?: s.hud.x.coerceIn(0,(c.window.guiScaledWidth-w*scale).roundToInt().coerceAtLeast(0))
+        val y=atY ?: s.hud.y.coerceIn(0,(c.window.guiScaledHeight-h*scale).roundToInt().coerceAtLeast(0))
+        g.pose().pushMatrix()
+        try {
+            g.pose().translate(x.toFloat(),y.toFloat());g.pose().scale(scale,scale)
+            ChromeDraw.premium(g,0,0,w,h,opacity(s.backgroundColor,s.backgroundOpacity),0x805d6269.toInt(),s.hud.color,6,rail=false)
+            if(s.vertical) {
+                items.forEachIndexed {index,item ->
+                    val tx=s.padding;val ty=s.padding+index*10
+                    text(g,c.font,"${item.label} ${item.value}",tx,ty,item.color,s.fontStyle)
+                }
+            } else {
+                var tx=s.padding
+                items.forEachIndexed {index,item ->
+                    text(g,c.font,"${item.label} ${item.value}",tx,s.padding,item.color,s.fontStyle)
+                    tx+=c.font.width("${item.label} ${item.value}")+s.padding*2+8
+                }
+            }
+        } finally {g.pose().popMatrix()}
+    }
+
+    fun editor(g:GuiGraphicsExtractor,key:String,x:Int,y:Int):Boolean {
+        if(key!="extra.performance") return false
+        draw(g,S.currentGeneral().features.performanceHud,true,x,y);return true
+    }
+
+    private fun render(g:GuiGraphicsExtractor) {
+        val c=Minecraft.getInstance()
+        if(c.player==null || c.level==null || c.gui.hud.isHidden) return
+        val screen=c.gui.screen()
+        if(screen is HudEditorScreen || screen!=null && screen !is NoFrillsClickGui) return
+        val s=S.currentGeneral().features.performanceHud
+        if(S.isEnabled(S.PERFORMANCE_HUD) && s.hud.enabled) draw(g,s)
+    }
+
+    fun register() {
+        HudElementRegistry.attachElementBefore(
+            VanillaHudElements.CHAT,
+            Identifier.fromNamespaceAndPath("solyanka","performance_hud")
+        ) {g,_->render(g)}
+    }
+}
\ No newline at end of file
