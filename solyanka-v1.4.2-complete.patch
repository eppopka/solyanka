+ /**
+  * Shared premium surface used by the ClickGUI, settings cards and HUD editor.
+  *
+  * The old `panel` primitive intentionally remains unchanged for feature-owned
+  * HUDs. This higher-level primitive adds the Move Hotbar treatment without
+  * forcing every in-world overlay to inherit a menu surface:
+  * soft offset shadow, clipped body, accent rail and a restrained top sheen.
+  */
+ fun premium(
+  g:GuiGraphicsExtractor,
+  x:Int,y:Int,w:Int,h:Int,
+  fill:Int,border:Int,
+  accent:Int=0xff7dd3fc.toInt(),
+  radius:Int=6,
+  selected:Boolean=false,
+  rail:Boolean=true
+ ) {
+  if(w<=0 || h<=0) return
+  val safeRadius=radius.coerceIn(0,minOf(w,h)/2)
+  panel(g,x+2,y+3,w,h,alpha(0x000000,if(selected) 0x66 else 0x42),0,safeRadius)
+  panel(g,x,y,w,h,fill,border,safeRadius)
+  if(rail && h>safeRadius*2+4) {
+   g.fill(x+3,y+safeRadius,x+5,y+h-safeRadius,alpha(accent,if(selected) 0xff else 0xb8))
+  }
+  if(w>safeRadius*2+4) {
+   val sheen=alpha(0xffffff,if(selected) 0x20 else 0x0f)
+   g.fill(x+safeRadius,y+1,x+w-safeRadius,y+2,sheen)
+  }
+ }
+
+ private fun alpha(color:Int,opacity:Int):Int =
+  (opacity.coerceIn(0,255) shl 24) or (color and 0x00ffffff)
 }
