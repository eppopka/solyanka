diff --git a/src/test/kotlin/dev/solyanka/model/AuditRegressionTest.kt b/src/test/kotlin/dev/solyanka/model/AuditRegressionTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..23f3ec248f7b7d573454da5bf0b3ea06094108d9
--- /dev/null
+++ b/src/test/kotlin/dev/solyanka/model/AuditRegressionTest.kt
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+package dev.solyanka.model
+
+import dev.solyanka.utility.ClickGuiSettings
+import dev.solyanka.utility.ThemeColors
+import org.junit.jupiter.api.Test
+import kotlin.test.*
+import java.nio.file.Path
+
+class AuditRegressionTest {
+ private fun source(path:String)=Path.of("src/client/kotlin/dev/solyanka/client",path).toFile().readText()
+ @Test fun `shared colors preserve existing defaults`() {
+  val s=ClickGuiSettings()
+  assertEquals(ThemeColors.ACCENT,s.enabledColor);assertEquals(ThemeColors.LINE,s.disabledBorderColor)
+  assertEquals(0xff7dd3fc.toInt(),s.enabledColor);assertEquals(0xffc3cede.toInt(),s.disabledColor)
+ }
+ @Test fun `editor uses one entry snapshot for a normal frame`() {
+  val frame=source("ui/HudEditorScreen.kt").substringAfter("override fun extractRenderState").substringBefore("override fun mouseClicked")
+  assertEquals(1,Regex("val current=entries ").findAll(frame).count())
+  assertTrue("ScoreboardHud.editorSnapshot()" in frame);assertTrue("scoreboardPreview.entry(it,width)" in frame)
+  assertTrue("scoreboardPreview.draw(g,b.x,b.y)" in frame)
+  assertTrue("current.firstOrNull" in frame)
+ }
+ @Test fun `HUD style edits are typed and title colors only update when changed`() {
+  val style=source("ui/HudStyleUi.kt")
+  assertFalse("toJsonTree" in style);assertFalse("FeatureCodec.decode" in style)
+  assertTrue("scoreboardHud=change(" in style);assertTrue("themedChat=change(" in style)
+  val gui=source("ui/nofrills/NoFrillsClickGui.kt")
+  assertTrue("if(color!=lastColor || highlight!=lastMatchColor)" in gui);assertTrue("ClickGradient.text(\"solyanka\"" in gui)
+  assertFalse("ClickGradient.text(name" in gui)
+ }
+ @Test fun `runtime version is read from fabric metadata`() {
+  assertTrue("metadata.version.friendlyString" in source("ModInfo.kt"))
+  for(path in listOf("SolyankaClient.kt","feature/YandexMusic.kt","feature/PriceTooltips.kt","feature/InfoTooltips.kt"))
+   assertFalse(Regex("Solyanka/[0-9]").containsMatchIn(source(path)),path)
+ }
+}
diff --git a/src/test/kotlin/dev/solyanka/model/FeatureFieldsTest.kt b/src/test/kotlin/dev/solyanka/model/FeatureFieldsTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2dab1b95a7d6aee027c6a95a5fe7500962a021dd
--- /dev/null
+++ b/src/test/kotlin/dev/solyanka/model/FeatureFieldsTest.kt
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+package dev.solyanka.model
+
+import com.google.gson.Gson
+import com.google.gson.JsonObject
+import com.google.gson.JsonPrimitive
+import dev.solyanka.utility.FeatureSettings
+import org.junit.jupiter.api.Test
+import kotlin.test.*
+import java.nio.file.Path
+import kotlin.io.path.readText
+
+class FeatureFieldsTest {
+ private val sections=listOf("environment","map","puzzles","prices","experiments","suppression", "worldVisuals.playerGlow","worldVisuals.nametags","worldVisuals.blockOutline","worldVisuals.titanium","inventoryHud","itemNameHud","skillHud")
+ private val gson=Gson()
+ private fun node(root:JsonObject,path:String):JsonObject = path.split('.').fold(root) {current,key->current.getAsJsonObject(key)}
+ @Test fun `descriptors mirror each legacy section and update only their target`() {
+  val initial=FeatureSettings();val original=gson.toJsonTree(initial).asJsonObject
+  sections.forEach {section->
+   val target=node(original,section)
+   val expectedNames=target.entrySet().filterNot {it.key=="hud"}.map {it.key}.toMutableSet()
+   if(target.has("hud")) expectedNames.addAll(listOf("hud.enabled","hud.color"))
+   val descriptors=FeatureFields.fields(initial,section)
+   assertEquals(expectedNames,descriptors.map {it.name}.toSet(),section)
+   assertEquals(descriptors.size,descriptors.map {it.name}.distinct().size,section)
+   descriptors.forEach {field->
+    val expected=original.deepCopy();val dest=node(expected,section)
+    val targetField=if(field.name.startsWith("hud.")) dest.getAsJsonObject("hud") else dest
+    val name=field.name.substringAfterLast('.')
+    val changed=when(field) {
+     is FeatureField.Flag -> {assertEquals(targetField[name].asBoolean,field.value);targetField.add(name,JsonPrimitive(!field.value));field.set(initial,!field.value)}
+     is FeatureField.Integer -> {assertEquals(targetField[name].asInt,field.value);val v=field.value xor 1;targetField.add(name,JsonPrimitive(v));field.set(initial,v)}
+     is FeatureField.Decimal -> {assertEquals(targetField[name].asDouble,field.value);val v=field.value+0.125;targetField.add(name,JsonPrimitive(v));field.set(initial,v)}
+    }
+    assertEquals(expected,gson.toJsonTree(changed).asJsonObject,"$section.${field.name}")
+   }
+  }
+ }
+ @Test fun `catalog field names are all covered by descriptors`() {
+  val f=FeatureSettings()
+  SettingsCatalog.panels.values.forEach {spec->
+   val fields=FeatureFields.fields(f,spec.section).map {it.name}.toSet()
+   assertTrue(fields.containsAll(spec.fields),"${spec.title}: ${spec.fields-fields}")
+  }
+ }
+ @Test fun `generic editors do not serialize feature state on every edit`() {
+  val root=Path.of("src/client/kotlin/dev/solyanka/client/ui")
+  listOf("AdvancedUi.kt","ExtraHudUi.kt","WorldVisualUi.kt","HudStyleUi.kt").forEach {name->
+   val text=root.resolve(name).readText();assertFalse("toJsonTree" in text,name);assertFalse("FeatureCodec.decode" in text,name)
+  }
